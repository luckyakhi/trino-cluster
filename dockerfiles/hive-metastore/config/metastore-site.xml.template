<?xml version="1.0"?>
<configuration>
    <!-- Metastore Thrift Service Configuration -->
    <property>
        <name>metastore.thrift.uris</name>
        <value>thrift://0.0.0.0:9083</value>
        <description>Thrift URI for the remote metastore</description>
    </property>

    <property>
        <name>metastore.thrift.port</name>
        <value>9083</value>
        <description>Port number for Thrift service</description>
    </property>

    <!-- PostgreSQL Database Connection -->
    <property>
        <name>javax.jdo.option.ConnectionURL</name>
        <value>jdbc:postgresql://${DB_HOST}:${DB_PORT}/${DB_NAME}</value>
        <description>JDBC connect string for PostgreSQL database</description>
    </property>

    <property>
        <name>javax.jdo.option.ConnectionDriverName</name>
        <value>org.postgresql.Driver</value>
        <description>Driver class name for PostgreSQL JDBC driver</description>
    </property>

    <property>
        <name>javax.jdo.option.ConnectionUserName</name>
        <value>${DB_USER}</value>
        <description>Username to use against PostgreSQL database</description>
    </property>

    <property>
        <name>javax.jdo.option.ConnectionPassword</name>
        <value>${DB_PASSWORD}</value>
        <description>Password to use against PostgreSQL database</description>
    </property>

    <!-- Connection Pool Settings -->
    <property>
        <name>datanucleus.connectionPoolingType</name>
        <value>HikariCP</value>
        <description>Connection pooling implementation</description>
    </property>

    <property>
        <name>datanucleus.connectionPool.maxPoolSize</name>
        <value>10</value>
        <description>Maximum number of connections in the pool</description>
    </property>

    <!-- Warehouse Directory (S3) -->
    <property>
        <name>metastore.warehouse.dir</name>
        <value>s3a://${S3_BUCKET}/warehouse/</value>
        <description>Default warehouse location on S3</description>
    </property>

    <!-- Task Threads -->
    <property>
        <name>metastore.task.threads.always</name>
        <value>org.apache.hadoop.hive.metastore.events.EventCleanerTask</value>
        <description>Metastore task threads</description>
    </property>

    <!-- Expression Proxy -->
    <property>
        <name>metastore.expression.proxy</name>
        <value>org.apache.hadoop.hive.metastore.DefaultPartitionExpressionProxy</value>
        <description>Expression proxy class for partition pruning</description>
    </property>

    <!-- Schema Verification -->
    <property>
        <name>hive.metastore.schema.verification</name>
        <value>true</value>
        <description>Enforce metastore schema version consistency</description>
    </property>

    <!-- Auto Create Schema -->
    <property>
        <name>datanucleus.schema.autoCreateAll</name>
        <value>false</value>
        <description>Do not auto-create schema, use schematool instead</description>
    </property>

    <!-- Event Listeners -->
    <property>
        <name>hive.metastore.event.db.notification.api.auth</name>
        <value>false</value>
        <description>Disable authentication for event notifications</description>
    </property>

    <!-- Storage Schema Reader -->
    <property>
        <name>metastore.storage.schema.reader.impl</name>
        <value>org.apache.hadoop.hive.metastore.SerDeStorageSchemaReader</value>
        <description>Storage schema reader implementation</description>
    </property>

    <!-- Cache Settings -->
    <property>
        <name>metastore.cache.pinobjtypes</name>
        <value>Table,Database,Type,FieldSchema,Order</value>
        <description>List of object types to cache</description>
    </property>

    <!-- Try Direct SQL -->
    <property>
        <name>datanucleus.query.sql.allowAll</name>
        <value>true</value>
        <description>Allow direct SQL queries for better performance</description>
    </property>
</configuration>
